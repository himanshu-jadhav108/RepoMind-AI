# Root Environment Configuration for RepoMind AI

# Backend Settings
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Frontend Settings
NEXT_PUBLIC_API_URL=http://localhost:8000

# P0-6 FIX: CORS Origins — override in production with your Vercel frontend URL.
# Supports JSON array or comma-separated string.
# Example for production: CORS_ORIGINS=https://repomind-ai.vercel.app,http://localhost:3000
# CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Supabase Credentials
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Provider API Keys
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
OPENAI_API_KEY=your-openai-api-key
HUGGINGFACE_API_KEY=your-huggingface-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
